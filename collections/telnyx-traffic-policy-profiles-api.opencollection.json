{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telnyx Access Tokens Traffic Policy Profiles API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Traffic Policy Profiles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all traffic policy profiles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/traffic_policy_profiles",
            "params": [
              {
                "name": "page[number]",
                "value": "",
                "type": "query",
                "description": "The page number to load."
              },
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "The size of the page."
              },
              {
                "name": "filter[type]",
                "value": "whitelist",
                "type": "query",
                "description": "Filter by traffic policy profile type."
              },
              {
                "name": "filter[service]",
                "value": "service_123",
                "type": "query",
                "description": "Filter by service ID."
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Sorts traffic policy profiles by the given field. Defaults to ascending order unless field is prefixed with a minus sign."
              }
            ]
          },
          "docs": "Get all traffic policy profiles belonging to the user that match the given filters."
        },
        {
          "info": {
            "name": "Create a traffic policy profile",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.telnyx.com/v2/traffic_policy_profiles",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new traffic policy profile. At least one of `services`, `ip_ranges`, or `domains` must be provided."
        },
        {
          "info": {
            "name": "Get all available traffic policy profile services",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/traffic_policy_profiles/services",
            "params": [
              {
                "name": "page[number]",
                "value": "",
                "type": "query",
                "description": "The page number to load."
              },
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "The size of the page."
              },
              {
                "name": "filter[group]",
                "value": "Social Media",
                "type": "query",
                "description": "Filter services by group."
              },
              {
                "name": "filter[name]",
                "value": "Netflix",
                "type": "query",
                "description": "Filter services by name."
              }
            ]
          },
          "docs": "Get all available PCEF services that can be used in traffic policy profiles."
        },
        {
          "info": {
            "name": "Get a traffic policy profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/traffic_policy_profiles/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Identifies the traffic policy profile."
              }
            ]
          },
          "docs": "Returns the details regarding a specific traffic policy profile."
        },
        {
          "info": {
            "name": "Update a traffic policy profile",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.telnyx.com/v2/traffic_policy_profiles/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Identifies the traffic policy profile."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates a traffic policy profile."
        },
        {
          "info": {
            "name": "Delete a traffic policy profile",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.telnyx.com/v2/traffic_policy_profiles/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Identifies the traffic policy profile."
              }
            ]
          },
          "docs": "Deletes the traffic policy profile."
        }
      ]
    }
  ],
  "bundled": true
}