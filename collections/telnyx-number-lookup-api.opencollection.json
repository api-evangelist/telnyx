{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telnyx Access Tokens Number Lookup API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Number Lookup",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Lookup phone number data",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/number_lookup/:phone_number",
            "params": [
              {
                "name": "phone_number",
                "value": "",
                "type": "path",
                "description": "The phone number to be looked up"
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Specifies the type of number lookup to be performed"
              }
            ]
          },
          "docs": "Returns information about the provided phone number."
        }
      ]
    }
  ],
  "bundled": true
}