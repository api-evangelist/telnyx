  "item": [
    {
      "id": "84018084-e854-4983-a6fc-7f7fe0dd7ffd",
      "name": "Speech To Text over WebSockets",
      "description": {
        "content": "Speech to text command operations",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "88d1bff3-c4fb-4e82-b5dc-d94e282df924",
          "name": "Speech to text over WebSocket",
          "request": {
            "name": "Speech to text over WebSocket",
            "description": {
              "content": "Open a WebSocket connection to stream audio and receive transcriptions in real-time. Authentication is provided via the standard `Authorization: Bearer <API_KEY>` header.\n\nSupported engines: `Azure`, `Deepgram`, `Google`, `Telnyx`, `xAI`, `Speechmatics`.\n\n**Connection flow:**\n1. Open WebSocket with query parameters specifying engine, input format, and language.\n2. Send binary audio frames (mp3/wav format).\n3. Receive JSON transcript frames with `transcript`, `is_final`, and `confidence` fields.\n4. Close connection when done.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "speech-to-text",
                "transcription"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "transcription_engine",
                  "value": "<string>",
                  "description": "(Required) The transcription engine to use for processing the audio stream."
                },
                {
                  "disabled": false,
                  "key": "input_format",
                  "value": "<string>",
                  "description": "(Required) The format of input audio stream."
                },
                {
                  "disabled": false,
                  "key": "language",
                  "value": "<string>",
                  "description": "The language spoken in the audio stream."
                },
                {
                  "disabled": false,
                  "key": "interim_results",
                  "value": "<boolean>",
                  "description": "Whether to receive interim transcription results."
                },
                {
                  "disabled": false,
                  "key": "model",
                  "value": "<string>",
                  "description": "The specific model to use within the selected transcription engine."
                },
                {
                  "disabled": false,
                  "key": "endpointing",
                  "value": "<integer>",
                  "description": "Silence duration (in milliseconds) that triggers end-of-speech detection. When set, the engine uses this value to determine when a speaker has stopped talking. Supported by `xAI`, `Deepgram`, `Google`, and `Speechmatics`. Other engines may not support this parameter."
                },
                {
                  "disabled": false,
                  "key": "redact",
                  "value": "<string>",
                  "description": "Enable redaction of sensitive information (e.g., PCI data, SSN) from transcription results. Supported values depend on the transcription engine."
                },
                {
                  "disabled": false,
                  "key": "keyterm",
                  "value": "<string>",
                  "description": "A key term to boost in the transcription. The engine will be more likely to recognize this term. Can be specified multiple times for multiple terms."
                },
                {
                  "disabled": false,
                  "key": "keywords",
                  "value": "<string>",
                  "description": "Comma-separated list of keywords to boost in the transcription. The engine will prioritize recognition of these words."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/octet-stream"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "<binary>"
            }
          },
          "response": [
