                  "raw": "{\n  \"aws\": {\n    \"language_code\": \"string\",\n    \"lexicon_names\": [\n      \"string\",\n      \"string\"\n    ],\n    \"output_format\": \"string\",\n    \"sample_rate\": \"string\",\n    \"text_type\": \"ssml\"\n  },\n  \"azure\": {\n    \"api_key\": \"string\",\n    \"deployment_id\": \"string\",\n    \"effect\": \"string\",\n    \"gender\": \"string\",\n    \"language_code\": \"en-US\",\n    \"output_format\": \"audio-24khz-160kbitrate-mono-mp3\",\n    \"region\": \"string\",\n    \"text_type\": \"text\"\n  },\n  \"disable_cache\": false,\n  \"elevenlabs\": {\n    \"api_key\": \"string\",\n    \"language_code\": \"string\",\n    \"voice_settings\": {\n      \"key_0\": \"string\",\n      \"key_1\": true\n    }\n  },\n  \"language\": \"<string>\",\n  \"minimax\": {\n    \"language_boost\": \"string\",\n    \"pitch\": 4061,\n    \"response_format\": \"string\",\n    \"speed\": 4816.287347543993,\n    \"vol\": 713.594531705365\n  },\n  \"output_type\": \"binary_output\",\n  \"provider\": \"<string>\",\n  \"resemble\": {\n    \"api_key\": \"string\",\n    \"format\": \"string\",\n    \"precision\": \"string\",\n    \"sample_rate\": \"string\"\n  },\n  \"rime\": {\n    \"response_format\": \"string\",\n    \"sampling_rate\": 3584,\n    \"voice_speed\": 9066.106038273947\n  },\n  \"telnyx\": {\n    \"emotion\": \"sad\",\n    \"response_format\": \"mp3\",\n    \"sampling_rate\": 24000,\n    \"temperature\": 0.5,\n    \"voice_speed\": 1,\n    \"volume\": 1\n  },\n  \"text\": \"<string>\",\n  \"text_type\": \"<string>\",\n  \"voice\": \"<string>\",\n  \"voice_settings\": {\n    \"key_0\": 6202\n  },\n  \"xai\": {\n    \"voice_id\": \"rex\",\n    \"language\": \"auto\",\n    \"output_format\": \"mp3\",\n    \"sample_rate\": 24000\n  }\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
