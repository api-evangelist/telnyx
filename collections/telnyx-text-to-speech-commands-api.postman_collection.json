        {
          "id": "aa4931ba-2be6-476b-98e3-0467849ba403",
          "name": "Generate speech from text",
          "request": {
            "name": "Generate speech from text",
            "description": {
              "content": "Generate synthesized speech audio from text input. Returns audio in the requested format (binary audio stream, base64-encoded JSON, or an audio URL for later retrieval).\n\nAuthentication is provided via the standard `Authorization: Bearer <API_KEY>` header.\n\nThe `voice` parameter provides a convenient shorthand to specify provider, model, and voice in a single string (e.g. `telnyx.NaturalHD.Alloy` or `Telnyx.Ultra.<voice_id>`). Alternatively, specify `provider` explicitly along with provider-specific parameters.\n\nSupported providers: `aws`, `telnyx`, `azure`, `elevenlabs`, `minimax`, `rime`, `resemble`, `xai`.\n\nThe Telnyx `Ultra` model supports 44 languages with emotion control, speed adjustment, and volume control. Use the `telnyx` provider-specific parameters to configure these features.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "text-to-speech",
                "speech"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"aws\": {\n    \"language_code\": \"<string>\",\n    \"lexicon_names\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"output_format\": \"<string>\",\n    \"sample_rate\": \"<string>\",\n    \"text_type\": \"<string>\"\n  },\n  \"azure\": {\n    \"api_key\": \"<string>\",\n    \"deployment_id\": \"<string>\",\n    \"effect\": \"<string>\",\n    \"gender\": \"<string>\",\n    \"language_code\": \"en-US\",\n    \"output_format\": \"audio-24khz-160kbitrate-mono-mp3\",\n    \"region\": \"<string>\",\n    \"text_type\": \"text\"\n  },\n  \"disable_cache\": false,\n  \"elevenlabs\": {\n    \"api_key\": \"<string>\",\n    \"language_code\": \"<string>\",\n    \"voice_settings\": {\n      \"key_0\": false\n    }\n  },\n  \"language\": \"<string>\",\n  \"minimax\": {\n    \"language_boost\": \"<string>\",\n    \"pitch\": \"<integer>\",\n    \"response_format\": \"<string>\",\n    \"speed\": \"<float>\",\n    \"vol\": \"<float>\"\n  },\n  \"output_type\": \"binary_output\",\n  \"provider\": \"<string>\",\n  \"resemble\": {\n    \"api_key\": \"<string>\",\n    \"format\": \"<string>\",\n    \"precision\": \"<string>\",\n    \"sample_rate\": \"<string>\"\n  },\n  \"rime\": {\n    \"response_format\": \"<string>\",\n    \"sampling_rate\": \"<integer>\",\n    \"voice_speed\": \"<float>\"\n  },\n  \"telnyx\": {\n    \"emotion\": \"<string>\",\n    \"response_format\": \"mp3\",\n    \"sampling_rate\": 24000,\n    \"temperature\": 0.5,\n    \"voice_speed\": 1,\n    \"volume\": 1\n  },\n  \"text\": \"<string>\",\n  \"text_type\": \"<string>\",\n  \"voice\": \"<string>\",\n  \"voice_settings\": {\n    \"key_0\": false,\n    \"key_1\": false,\n    \"key_2\": false\n  },\n  \"xai\": {\n    \"voice_id\": \"<string>\",\n    \"language\": \"auto\",\n    \"output_format\": \"mp3\",\n    \"sample_rate\": 24000\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "dff788de-2e55-449f-aa04-4283930c3c54",
              "name": "Speech generated successfully. The response format depends on the `output_type` parameter:\n- `binary_output` (default): Returns raw audio bytes with the appropriate `Content-Type` header (e.g. `audio/mpeg`).\n- `base64_output`: Returns a JSON object with `base64_audio` field.",
              "originalRequest": {
                "url": {
                  "path": [
                    "text-to-speech",
                    "speech"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
