{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telnyx Access Tokens Audio API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Audio",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Transcribe speech to text",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.telnyx.com/v2/ai/audio/transcriptions",
            "body": {
              "type": "multipart-form",
              "data": []
            }
          },
          "docs": "Transcribe speech to text. This endpoint is consistent with the [OpenAI Transcription API](https://platform.openai.com/docs/api-reference/audio/createTranscription) and may be used with the OpenAI JS or Python SDK."
        }
      ]
    }
  ],
  "bundled": true
}