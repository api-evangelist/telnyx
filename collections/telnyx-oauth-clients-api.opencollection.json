{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telnyx Access Tokens OAuth Clients API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "OAuth Clients",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List OAuth clients",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/oauth_clients",
            "params": [
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "Number of results per page"
              },
              {
                "name": "page[number]",
                "value": "",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "filter[client_type]",
                "value": "",
                "type": "query",
                "description": "Filter by client type"
              },
              {
                "name": "filter[verified]",
                "value": "",
                "type": "query",
                "description": "Filter by verification status"
              },
              {
                "name": "filter[allowed_grant_types][contains]",
                "value": "",
                "type": "query",
                "description": "Filter by allowed grant type"
              },
              {
                "name": "filter[name]",
                "value": "",
                "type": "query",
                "description": "Filter by exact client name"
              },
              {
                "name": "filter[name][contains]",
                "value": "",
                "type": "query",
                "description": "Filter by client name containing text"
              },
              {
                "name": "filter[client_id]",
                "value": "",
                "type": "query",
                "description": "Filter by client ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve a paginated list of OAuth clients for the authenticated user"
        },
        {
          "info": {
            "name": "Create OAuth client",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.telnyx.com/v2/oauth_clients",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a new OAuth client"
        },
        {
          "info": {
            "name": "Get OAuth client",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/oauth_clients/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "OAuth client ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve a single OAuth client by ID"
        },
        {
          "info": {
            "name": "Update OAuth client",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.telnyx.com/v2/oauth_clients/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "OAuth client ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update an existing OAuth client"
        },
        {
          "info": {
            "name": "Delete OAuth client",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.telnyx.com/v2/oauth_clients/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "OAuth client ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete an OAuth client"
        }
      ]
    }
  ],
  "bundled": true
}