                "name": "enterprise_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the enterprise (UUID)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update enterprise information. All fields are optional — only the provided fields will be updated."
