            "url": "https://api.telnyx.com/v2/enterprises/:enterprise_id",
            "params": [
              {
                "name": "enterprise_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the enterprise (UUID)"
              }
            ]
          },
          "docs": "Delete an enterprise and all associated resources. This action is irreversible."
