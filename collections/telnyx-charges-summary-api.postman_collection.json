          "request": {
            "name": "Get monthly charges summary",
            "description": {
              "content": "Retrieve a summary of monthly charges for a specified date range. The date range cannot exceed 31 days.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "charges_summary"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<date>",
                  "description": "(Required) Start date for the charges summary in ISO date format (YYYY-MM-DD)"
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<date>",
                  "description": "(Required) End date for the charges summary in ISO date format (YYYY-MM-DD). The date is exclusive, data for the end_date itself is not included in the report. The interval between start_date and end_date cannot exceed 31 days."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
