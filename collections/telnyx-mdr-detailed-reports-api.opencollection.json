{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telnyx Access Tokens MDR Detailed Reports API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "MDR Detailed Reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all MDR detailed report requests",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/legacy/reporting/batch_detail_records/messaging",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves all MDR detailed report requests for the authenticated user"
        },
        {
          "info": {
            "name": "Create a new MDR detailed report request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.telnyx.com/v2/legacy/reporting/batch_detail_records/messaging",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a new MDR detailed report request with the specified filters"
        },
        {
          "info": {
            "name": "Get a specific MDR detailed report request",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/legacy/reporting/batch_detail_records/messaging/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves a specific MDR detailed report request by ID"
        },
        {
          "info": {
            "name": "Delete a MDR detailed report request",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.telnyx.com/v2/legacy/reporting/batch_detail_records/messaging/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Deletes a specific MDR detailed report request by ID"
        }
      ]
    }
  ],
  "bundled": true
}