{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telnyx Access Tokens Voicemail API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Voicemail",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get voicemail",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/phone_numbers/:phone_number_id/voicemail",
            "params": [
              {
                "name": "phone_number_id",
                "value": "123455678900",
                "type": "path",
                "description": "The ID of the phone number."
              }
            ]
          },
          "docs": "Returns the voicemail settings for a phone number"
        },
        {
          "info": {
            "name": "Create voicemail",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.telnyx.com/v2/phone_numbers/:phone_number_id/voicemail",
            "params": [
              {
                "name": "phone_number_id",
                "value": "123455678900",
                "type": "path",
                "description": "The ID of the phone number."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create voicemail settings for a phone number"
        },
        {
          "info": {
            "name": "Update voicemail",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.telnyx.com/v2/phone_numbers/:phone_number_id/voicemail",
            "params": [
              {
                "name": "phone_number_id",
                "value": "123455678900",
                "type": "path",
                "description": "The ID of the phone number."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update voicemail settings for a phone number"
        }
      ]
    }
  ],
  "bundled": true
}