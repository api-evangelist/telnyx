{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telnyx Access Tokens CSV Downloads API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "CSV Downloads",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List CSV downloads",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/phone_numbers/csv_downloads",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Consolidated page parameter (deepObject style). Originally: page[size], page[number]"
              }
            ]
          },
          "docs": "List CSV downloads"
        },
        {
          "info": {
            "name": "Create a CSV download",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.telnyx.com/v2/phone_numbers/csv_downloads",
            "params": [
              {
                "name": "csv_format",
                "value": "",
                "type": "query",
                "description": "Which format to use when generating the CSV file. The default for backwards compatibility is 'V1'"
              },
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Consolidated filter parameter (deepObject style). Originally: filter[has_bundle], filter[tag], filter[connection_id], filter[phone_number], filter[status], filter[voice.connection_name], filter[voice.usage_payment_method], filter[billing_group_id], filter[emergency_address_id], filter[customer_reference]"
              }
            ]
          },
          "docs": "Create a CSV download"
        },
        {
          "info": {
            "name": "Retrieve a CSV download",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/phone_numbers/csv_downloads/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Identifies the CSV download."
              }
            ]
          },
          "docs": "Retrieve a CSV download"
        }
      ]
    }
  ],
  "bundled": true
}