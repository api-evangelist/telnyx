{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telnyx Access Tokens Bundles API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Bundles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve Bundles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/bundle_pricing/billing_bundles",
            "headers": [
              {
                "name": "authorization_bearer",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Consolidated filter parameter (deepObject style). Supports filtering by country_iso and resource. Examples: filter[country_iso]=US or filter[resource]=+15617819942"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Consolidated page parameter (deepObject style). Originally: page[size], page[number]"
              }
            ]
          },
          "docs": "Get all allowed bundles."
        },
        {
          "info": {
            "name": "Get Bundle By Id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/bundle_pricing/billing_bundles/:bundle_id",
            "headers": [
              {
                "name": "authorization_bearer",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "bundle_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a single bundle by ID."
        }
      ]
    }
  ],
  "bundled": true
}