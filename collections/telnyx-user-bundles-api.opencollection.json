{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telnyx Access Tokens User Bundles API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "User Bundles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get User Bundles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/bundle_pricing/user_bundles",
            "headers": [
              {
                "name": "authorization_bearer",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Consolidated filter parameter (deepObject style). Supports filtering by country_iso and resource. Examples: filter[country_iso]=US or filter[resource]=+15617819942"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Consolidated page parameter (deepObject style). Originally: page[size], page[number]"
              }
            ]
          },
          "docs": "Get a paginated list of user bundles."
        },
        {
          "info": {
            "name": "Create User Bundles",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.telnyx.com/v2/bundle_pricing/user_bundles/bulk",
            "headers": [
              {
                "name": "authorization_bearer",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates multiple user bundles for the user."
        },
        {
          "info": {
            "name": "Get Unused User Bundles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/bundle_pricing/user_bundles/unused",
            "headers": [
              {
                "name": "authorization_bearer",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Consolidated filter parameter (deepObject style). Supports filtering by country_iso and resource. Examples: filter[country_iso]=US or filter[resource]=+15617819942"
              }
            ]
          },
          "docs": "Returns all user bundles that aren't in use."
        },
        {
          "info": {
            "name": "Get User Bundle by Id",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/bundle_pricing/user_bundles/:user_bundle_id",
            "headers": [
              {
                "name": "authorization_bearer",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "user_bundle_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves a user bundle by its ID."
        },
        {
          "info": {
            "name": "Deactivate User Bundle",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.telnyx.com/v2/bundle_pricing/user_bundles/:user_bundle_id",
            "headers": [
              {
                "name": "authorization_bearer",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "user_bundle_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Deactivates a user bundle by its ID."
        },
        {
          "info": {
            "name": "Get User Bundle Resources",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/bundle_pricing/user_bundles/:user_bundle_id/resources",
            "headers": [
              {
                "name": "authorization_bearer",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "user_bundle_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves the resources of a user bundle by its ID."
        }
      ]
    }
  ],
  "bundled": true
}