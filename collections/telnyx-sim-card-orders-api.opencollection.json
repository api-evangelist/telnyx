{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telnyx Access Tokens SIM Card Orders API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "SIM Card Orders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Preview SIM card orders",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.telnyx.com/v2/sim_card_order_preview",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Preview SIM card order purchases."
        },
        {
          "info": {
            "name": "Get all SIM card orders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/sim_card_orders",
            "params": [
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Consolidated filter parameter for SIM card orders (deepObject style). Originally: filter[created_at], filter[updated_at], filter[quantity], filter[cost.amount], filter[cost.currency], filter[address.id], filter[address.street_address], filter[address.extended_address], filter[address.locality], filter[address.administrative_area], filter[address.country_code], filter[address.postal_code]"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Consolidated pagination parameter (deepObject style). Originally: page[number], page[size]"
              }
            ]
          },
          "docs": "Get all SIM card orders according to filters."
        },
        {
          "info": {
            "name": "Create a SIM card order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.telnyx.com/v2/sim_card_orders",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new order for SIM cards."
        },
        {
          "info": {
            "name": "Get a single SIM card order",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/sim_card_orders/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Identifies the resource."
              }
            ]
          },
          "docs": "Get a single SIM card order by its ID."
        }
      ]
    }
  ],
  "bundled": true
}