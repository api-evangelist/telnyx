          "name": "Create embeddings",
          "request": {
            "name": "Create embeddings",
            "description": {
              "content": "Creates an embedding vector representing the input text. This endpoint is compatible with the [OpenAI Embeddings API](https://platform.openai.com/docs/api-reference/embeddings) and may be used with the OpenAI JS or Python SDK by setting the base URL to `https://api.telnyx.com/v2/ai/openai`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ai",
                "openai",
                "embeddings"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input\": \"<string>\",\n  \"model\": \"<string>\",\n  \"dimensions\": \"<integer>\",\n  \"encoding_format\": \"float\",\n  \"user\": \"<string>\"\n}",
