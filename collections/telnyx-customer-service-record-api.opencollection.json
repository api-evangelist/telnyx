{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telnyx Access Tokens Customer Service Record API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Customer Service Record",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List customer service records",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/customer_service_records",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Consolidated page parameter (deepObject style). Originally: page[size], page[number]"
              },
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Consolidated filter parameter (deepObject style). Originally: filter[phone_number][eq], filter[phone_number][in][], filter[status][eq], filter[status][in][], filter[created_at][lt], filter[created_at][gt]"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Consolidated sort parameter (deepObject style). Originally: sort[value]"
              }
            ]
          },
          "docs": "List customer service records."
        },
        {
          "info": {
            "name": "Create a customer service record",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.telnyx.com/v2/customer_service_records",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new customer service record for the provided phone number."
        },
        {
          "info": {
            "name": "Verify CSR phone number coverage",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.telnyx.com/v2/customer_service_records/phone_number_coverages",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Verify the coverage for a list of phone numbers."
        },
        {
          "info": {
            "name": "Get a customer service record",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/customer_service_records/:customer_service_record_id",
            "params": [
              {
                "name": "customer_service_record_id",
                "value": "",
                "type": "path",
                "description": "The ID of the customer service record"
              }
            ]
          },
          "docs": "Get a specific customer service record."
        }
      ]
    }
  ],
  "bundled": true
}