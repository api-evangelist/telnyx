{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telnyx Access Tokens Regions API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Regions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all Regions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/regions"
          },
          "docs": "List all regions and the interfaces that region supports"
        }
      ]
    }
  ],
  "bundled": true
}