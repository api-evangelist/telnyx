{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telnyx Access Tokens WDR Detail Reports API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "WDR Detail Reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fetches all Wdr records",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/reports/wdrs",
            "params": [
              {
                "name": "start_date",
                "value": "",
                "type": "query",
                "description": "Start date"
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query",
                "description": "End date"
              },
              {
                "name": "id",
                "value": "",
                "type": "query"
              },
              {
                "name": "mcc",
                "value": "",
                "type": "query"
              },
              {
                "name": "mnc",
                "value": "",
                "type": "query"
              },
              {
                "name": "imsi",
                "value": "",
                "type": "query"
              },
              {
                "name": "sim_group_name",
                "value": "",
                "type": "query"
              },
              {
                "name": "sim_group_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "sim_card_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "phone_number",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Consolidated page parameter (deepObject style). Originally: page[number], page[size]"
              }
            ]
          },
          "docs": "Fetch all Wdr records "
        }
      ]
    }
  ],
  "bundled": true
}