          "name": "Create Client Token to join a room.",
          "request": {
            "name": "Create Client Token to join a room.",
            "description": {
              "content": "Synchronously create an Client Token to join a Room. Client Token is necessary to join a Telnyx Room. Client Token will expire after `token_ttl_secs`, a Refresh Token is also provided to refresh a Client Token, the Refresh Token expires after `refresh_token_ttl_secs`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rooms",
                ":room_id",
                "actions",
                "generate_join_client_token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
