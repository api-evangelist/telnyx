{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telnyx Access Tokens Phone Number Reservations API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Phone Number Reservations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List number reservations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/number_reservations",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Consolidated page parameter (deepObject style). Originally: page[size], page[number]"
              },
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Consolidated filter parameter (deepObject style). Originally: filter[status], filter[created_at], filter[phone_numbers.phone_number], filter[customer_reference]"
              }
            ]
          },
          "docs": "Gets a paginated list of phone number reservations."
        },
        {
          "info": {
            "name": "Create a number reservation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.telnyx.com/v2/number_reservations",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a Phone Number Reservation for multiple numbers."
        },
        {
          "info": {
            "name": "Retrieve a number reservation",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/number_reservations/:number_reservation_id",
            "params": [
              {
                "name": "number_reservation_id",
                "value": "",
                "type": "path",
                "description": "The number reservation ID."
              }
            ]
          },
          "docs": "Gets a single phone number reservation."
        },
        {
          "info": {
            "name": "Extend a number reservation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.telnyx.com/v2/number_reservations/:number_reservation_id/actions/extend",
            "params": [
              {
                "name": "number_reservation_id",
                "value": "",
                "type": "path",
                "description": "The number reservation ID."
              }
            ]
          },
          "docs": "Extends reservation expiry time on all phone numbers."
        }
      ]
    }
  ],
  "bundled": true
}