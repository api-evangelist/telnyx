{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telnyx Access Tokens Wireless Regions API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Wireless Regions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all wireless regions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/wireless/regions",
            "params": [
              {
                "name": "product",
                "value": "",
                "type": "query",
                "description": "The product for which to list regions (e.g., 'public_ips', 'private_wireless_gateways')."
              }
            ]
          },
          "docs": "Retrieve all wireless regions for the given product."
        }
      ]
    }
  ],
  "bundled": true
}