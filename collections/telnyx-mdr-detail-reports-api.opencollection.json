{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telnyx Access Tokens MDR Detail Reports API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "MDR Detail Reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Fetch all Mdr records",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/reports/mdrs",
            "params": [
              {
                "name": "start_date",
                "value": "",
                "type": "query",
                "description": "Pagination start date"
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query",
                "description": "Pagination end date"
              },
              {
                "name": "id",
                "value": "",
                "type": "query"
              },
              {
                "name": "direction",
                "value": "",
                "type": "query"
              },
              {
                "name": "profile",
                "value": "",
                "type": "query"
              },
              {
                "name": "cld",
                "value": "",
                "type": "query"
              },
              {
                "name": "cli",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              },
              {
                "name": "message_type",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Fetch all Mdr records "
        }
      ]
    }
  ],
  "bundled": true
}