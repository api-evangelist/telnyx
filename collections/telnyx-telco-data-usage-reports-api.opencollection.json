{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telnyx Access Tokens Telco Data Usage Reports API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Telco Data Usage Reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List telco data usage reports",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/legacy/reporting/usage_reports/number_lookup",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve a paginated list of telco data usage reports"
        },
        {
          "info": {
            "name": "Submit telco data usage report",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.telnyx.com/v2/legacy/reporting/usage_reports/number_lookup",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Submit a new telco data usage report"
        },
        {
          "info": {
            "name": "Get telco data usage report by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/legacy/reporting/usage_reports/number_lookup/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve a specific telco data usage report by its ID"
        },
        {
          "info": {
            "name": "Delete telco data usage report",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.telnyx.com/v2/legacy/reporting/usage_reports/number_lookup/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete a specific telco data usage report by its ID"
        }
      ]
    }
  ],
  "bundled": true
}