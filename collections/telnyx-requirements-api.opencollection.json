{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telnyx Access Tokens Requirements API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Requirements",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all requirements",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/requirements",
            "params": [
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Consolidated filter parameter for requirements (deepObject style). Originally: filter[country_code], filter[phone_number_type], filter[action]"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Consolidated sort parameter for requirements (deepObject style). Originally: sort[]"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Consolidated page parameter (deepObject style). Originally: page[size], page[number]"
              }
            ]
          },
          "docs": "List all requirements with filtering, sorting, and pagination"
        },
        {
          "info": {
            "name": "Retrieve a document requirement",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/requirements/:id",
            "params": [
              {
                "name": "id",
                "value": "a9dad8d5-fdbd-49d7-aa23-39bb08a5ebaa",
                "type": "path",
                "description": "Uniquely identifies the requirement_type record"
              }
            ]
          },
          "docs": "Retrieve a document requirement record"
        }
      ]
    }
  ],
  "bundled": true
}