{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telnyx Access Tokens Dynamic Emergency Addresses API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Dynamic Emergency Addresses",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List dynamic emergency addresses",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/dynamic_emergency_addresses",
            "params": [
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Consolidated filter parameter (deepObject style). Originally: filter[status], filter[country_code]"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Consolidated page parameter (deepObject style). Originally: page[size], page[number]"
              }
            ]
          },
          "docs": "Returns the dynamic emergency addresses according to filters"
        },
        {
          "info": {
            "name": "Create a dynamic emergency address.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.telnyx.com/v2/dynamic_emergency_addresses",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a dynamic emergency address."
        },
        {
          "info": {
            "name": "Get a dynamic emergency address",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/dynamic_emergency_addresses/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Dynamic Emergency Address id"
              }
            ]
          },
          "docs": "Returns the dynamic emergency address based on the ID provided"
        },
        {
          "info": {
            "name": "Delete a dynamic emergency address",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.telnyx.com/v2/dynamic_emergency_addresses/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Dynamic Emergency Address id"
              }
            ]
          },
          "docs": "Deletes the dynamic emergency address based on the ID provided"
        }
      ]
    }
  ],
  "bundled": true
}