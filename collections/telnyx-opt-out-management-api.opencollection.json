{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telnyx Access Tokens Opt-Out Management API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Opt-Out Management",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List opt-outs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/messaging_optouts",
            "params": [
              {
                "name": "redaction_enabled",
                "value": "+447766****",
                "type": "query",
                "description": "If receiving address (+E.164 formatted phone number) should be redacted"
              },
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Consolidated filter parameter (deepObject style). Originally: filter[messaging_profile_id], filter[from]"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Consolidated page parameter (deepObject style). Originally: page[number], page[size]"
              },
              {
                "name": "created_at",
                "value": "",
                "type": "query",
                "description": "Consolidated created_at parameter (deepObject style). Originally: created_at[gte], created_at[lte]"
              }
            ]
          },
          "docs": "Retrieve a list of opt-out blocks."
        },
        {
          "info": {
            "name": "List Auto-Response Settings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/messaging_profiles/:profile_id/autoresp_configs",
            "params": [
              {
                "name": "profile_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "country_code",
                "value": "",
                "type": "query"
              },
              {
                "name": "created_at",
                "value": "",
                "type": "query",
                "description": "Consolidated created_at parameter (deepObject style). Originally: created_at[gte], created_at[lte]"
              },
              {
                "name": "updated_at",
                "value": "",
                "type": "query",
                "description": "Consolidated updated_at parameter (deepObject style). Originally: updated_at[gte], updated_at[lte]"
              }
            ]
          },
          "docs": "List Auto-Response Settings"
        },
        {
          "info": {
            "name": "Create auto-response setting",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.telnyx.com/v2/messaging_profiles/:profile_id/autoresp_configs",
            "params": [
              {
                "name": "profile_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create auto-response setting"
        },
        {
          "info": {
            "name": "Get Auto-Response Setting",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/messaging_profiles/:profile_id/autoresp_configs/:autoresp_cfg_id",
            "params": [
              {
                "name": "profile_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "autoresp_cfg_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Auto-Response Setting"
        },
        {
          "info": {
            "name": "Update Auto-Response Setting",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.telnyx.com/v2/messaging_profiles/:profile_id/autoresp_configs/:autoresp_cfg_id",
            "params": [
              {
                "name": "profile_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "autoresp_cfg_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update Auto-Response Setting"
        },
        {
          "info": {
            "name": "Delete Auto-Response Setting",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.telnyx.com/v2/messaging_profiles/:profile_id/autoresp_configs/:autoresp_cfg_id",
            "params": [
              {
                "name": "profile_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "autoresp_cfg_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete Auto-Response Setting"
        }
      ]
    }
  ],
  "bundled": true
}