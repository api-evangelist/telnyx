    {
      "id": "20918c20-d5e3-4e55-9422-e54c12695943",
      "name": "x402 Payment Transactions",
      "description": {
        "content": "Operations for x402 cryptocurrency payment transactions. Fund your Telnyx account using USDC stablecoin payments via the x402 protocol.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "41153f73-9f29-401f-b14e-50fad0e13580",
          "name": "Settle a payment",
          "request": {
            "name": "Settle a payment",
            "description": {
              "content": "Settles an x402 payment using the quote ID and a signed payment authorization. The payment signature can be provided via the `PAYMENT-SIGNATURE` header or the `payment_signature` body parameter. Settlement is idempotent — submitting the same quote ID multiple times returns the existing transaction.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "x402",
                "credit_account"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "Signed payment authorization for the quote. Alternative to providing `payment_signature` in the request body.",
                "key": "PAYMENT-SIGNATURE",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"<string>\",\n  \"payment_signature\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
