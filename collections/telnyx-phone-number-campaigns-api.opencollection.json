        {
          "info": {
            "name": "Delete Phone Number Campaign",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.telnyx.com/v2/10dlc/phone_number_campaigns/:phoneNumber",
            "params": [
              {
                "name": "phoneNumber",
                "value": "",
                "type": "path"
              }
            ]
