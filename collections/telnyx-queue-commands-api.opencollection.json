{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telnyx Access Tokens Queue Commands API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Queue Commands",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List queues",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/queues",
            "params": [
              {
                "name": "page[number]",
                "value": "",
                "type": "query",
                "description": "The page number to load"
              },
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "The size of the page"
              }
            ]
          },
          "docs": "List all queues for the authenticated user."
        },
        {
          "info": {
            "name": "Create a queue",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.telnyx.com/v2/queues",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new call queue."
        },
        {
          "info": {
            "name": "Retrieve a call queue",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/queues/:queue_name",
            "params": [
              {
                "name": "queue_name",
                "value": "",
                "type": "path",
                "description": "Uniquely identifies the queue by name"
              }
            ]
          },
          "docs": "Retrieve an existing call queue"
        },
        {
          "info": {
            "name": "Update a queue",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.telnyx.com/v2/queues/:queue_name",
            "params": [
              {
                "name": "queue_name",
                "value": "",
                "type": "path",
                "description": "Uniquely identifies the queue by name"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update properties of an existing call queue."
        },
        {
          "info": {
            "name": "Delete a queue",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.telnyx.com/v2/queues/:queue_name",
            "params": [
              {
                "name": "queue_name",
                "value": "",
                "type": "path",
                "description": "Uniquely identifies the queue by name"
              }
            ]
          },
          "docs": "Delete an existing call queue."
        },
        {
          "info": {
            "name": "Retrieve calls from a queue",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/queues/:queue_name/calls",
            "params": [
              {
                "name": "queue_name",
                "value": "",
                "type": "path",
                "description": "Uniquely identifies the queue by name"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Consolidated page parameter (deepObject style). Originally: page[after], page[before], page[limit], page[size], page[number]"
              }
            ]
          },
          "docs": "Retrieve the list of calls in an existing queue"
        },
        {
          "info": {
            "name": "Retrieve a call from a queue",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/queues/:queue_name/calls/:call_control_id",
            "params": [
              {
                "name": "queue_name",
                "value": "",
                "type": "path",
                "description": "Uniquely identifies the queue by name"
              },
              {
                "name": "call_control_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier and token for controlling the call"
              }
            ]
          },
          "docs": "Retrieve an existing call from an existing queue"
        },
        {
          "info": {
            "name": "Update queued call",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.telnyx.com/v2/queues/:queue_name/calls/:call_control_id",
            "params": [
              {
                "name": "queue_name",
                "value": "",
                "type": "path",
                "description": "Uniquely identifies the queue by name"
              },
              {
                "name": "call_control_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier and token for controlling the call"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update queued call's keep_after_hangup flag"
        },
        {
          "info": {
            "name": "Force remove a call from a queue",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.telnyx.com/v2/queues/:queue_name/calls/:call_control_id",
            "params": [
              {
                "name": "queue_name",
                "value": "",
                "type": "path",
                "description": "Uniquely identifies the queue by name"
              },
              {
                "name": "call_control_id",
                "value": "",
                "type": "path",
                "description": "Unique identifier and token for controlling the call"
              }
            ]
          },
          "docs": "Removes an inactive call from a queue. If the call is no longer active, use this command to remove it from the queue."
        }
      ]
    }
  ],
  "bundled": true
}