          "name": "Create a chat completion (OpenAI-compatible)",
          "request": {
            "name": "Create a chat completion (OpenAI-compatible)",
            "description": {
              "content": "Chat with a language model. This endpoint is consistent with the [OpenAI Chat Completions API](https://platform.openai.com/docs/api-reference/chat) and may be used with the OpenAI JS or Python SDK by setting the base URL to `https://api.telnyx.com/v2/ai/openai`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ai",
                "openai",
                "chat",
                "completions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    {\n      \"content\": \"<string>\",\n      \"role\": \"<string>\"\n    },\n    {\n      \"content\": \"<string>\",\n      \"role\": \"<string>\"\n    }\n  ],\n  \"api_key_ref\": \"<string>\",\n  \"best_of\": \"<integer>\",\n  \"early_stopping\": false,\n  \"enable_thinking\": true,\n  \"frequency_penalty\": 0,\n  \"guided_choice\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"guided_json\": {\n    \"key_0\": true,\n    \"key_1\": \"string\"\n  },\n  \"guided_regex\": \"<string>\",\n  \"length_penalty\": 1,\n  \"logprobs\": false,\n  \"max_tokens\": \"<integer>\",\n  \"min_p\": \"<number>\",\n  \"model\": \"meta-llama/Meta-Llama-3.1-8B-Instruct\",\n  \"n\": \"<number>\",\n  \"presence_penalty\": 0,\n  \"response_format\": {\n    \"type\": \"<string>\"\n  },\n  \"seed\": \"<integer>\",\n  \"stop\": \"<string>\",\n  \"stream\": false,\n  \"temperature\": 0.1,\n  \"tool_choice\": \"<string>\",\n  \"tools\": [\n    {\n      \"function\": {\n        \"name\": \"<string>\",\n        \"description\": \"<string>\",\n        \"parameters\": {\n          \"key_0\": \"string\"\n        }\n      },\n      \"type\": \"<string>\"\n    },\n    {\n      \"function\": {\n        \"name\": \"<string>\",\n        \"description\": \"<string>\",\n        \"parameters\": {\n          \"key_0\": 6762,\n          \"key_1\": 8606\n        }\n      },\n      \"type\": \"<string>\"\n    }\n  ],\n  \"top_logprobs\": \"<integer>\",\n  \"top_p\": \"<number>\",\n  \"use_beam_search\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
