{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telnyx Access Tokens Session Analysis API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Session Analysis",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get metadata overview",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/session_analysis/metadata"
          },
          "docs": "Returns all available record types and supported query parameters for session analysis."
        },
        {
          "info": {
            "name": "Get record type metadata",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/session_analysis/metadata/:record_type",
            "params": [
              {
                "name": "record_type",
                "value": "",
                "type": "path",
                "description": "The record type identifier (e.g. \"call-control\")."
              }
            ]
          },
          "docs": "Returns detailed metadata for a specific record type, including relationships and examples."
        },
        {
          "info": {
            "name": "Get session analysis",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/session_analysis/:record_type/:event_id",
            "params": [
              {
                "name": "record_type",
                "value": "",
                "type": "path",
                "description": "The record type identifier."
              },
              {
                "name": "event_id",
                "value": "",
                "type": "path",
                "description": "The event identifier (UUID)."
              },
              {
                "name": "include_children",
                "value": "",
                "type": "query",
                "description": "Whether to include child events in the response."
              },
              {
                "name": "max_depth",
                "value": "",
                "type": "query",
                "description": "Maximum traversal depth for the event tree."
              },
              {
                "name": "expand",
                "value": "",
                "type": "query",
                "description": "Controls what data to expand on each event node."
              },
              {
                "name": "date_time",
                "value": "",
                "type": "query",
                "description": "ISO 8601 timestamp or date to narrow index selection for faster lookups. Accepts full datetime (e.g., 2026-03-17T10:00:00Z) or date-only format (e.g., 2026-03-17)."
              }
            ]
          },
          "docs": "Retrieves a full session analysis tree for a given event, including costs, child events, and product linkages."
        }
      ]
    }
  ],
  "bundled": true
}