{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telnyx Access Tokens Inexplicit Number Orders API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Inexplicit Number Orders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List inexplicit number orders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/inexplicit_number_orders",
            "params": [
              {
                "name": "page_number",
                "value": "",
                "type": "query",
                "description": "The page number to load"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "The size of the page"
              }
            ]
          },
          "docs": "Get a paginated list of inexplicit number orders."
        },
        {
          "info": {
            "name": "Create an inexplicit number order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.telnyx.com/v2/inexplicit_number_orders",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an inexplicit number order to programmatically purchase phone numbers without specifying exact numbers."
        },
        {
          "info": {
            "name": "Retrieve an inexplicit number order",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/inexplicit_number_orders/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Identifies the inexplicit number order"
              }
            ]
          },
          "docs": "Get an existing inexplicit number order by ID."
        }
      ]
    }
  ],
  "bundled": true
}