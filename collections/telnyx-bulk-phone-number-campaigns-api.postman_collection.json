        {
          "id": "0e897fe2-b993-4159-a62c-8f1edfbfa020",
          "name": "Assign Messaging Profile To Campaign",
          "request": {
            "name": "Assign Messaging Profile To Campaign",
            "description": {
              "content": "This endpoint allows you to link all phone numbers associated with a Messaging Profile to a campaign. **Please note:** if you want to assign phone numbers to a campaign that you did not create with Telnyx 10DLC services, this endpoint allows that provided that you've shared the campaign with Telnyx. In this case, only provide the parameter, `tcrCampaignId`, and not `campaignId`. In all other cases (where the campaign you're assigning was created with Telnyx 10DLC services), only provide `campaignId`, not `tcrCampaignId`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "10dlc",
                "phoneNumberAssignmentByProfile"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messagingProfileId\": \"<string>\",\n  \"campaignId\": \"<string>\",\n  \"tcrCampaignId\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
