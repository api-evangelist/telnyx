{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telnyx Access Tokens Mobile Number Settings API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Mobile Number Settings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List mobile phone numbers with messaging settings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/mobile_phone_numbers/messaging",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Consolidated page parameter (deepObject style). Originally: page[number], page[size]"
              }
            ]
          },
          "docs": "List mobile phone numbers with messaging settings"
        },
        {
          "info": {
            "name": "Retrieve a mobile phone number with messaging settings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/mobile_phone_numbers/:id/messaging",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Identifies the type of resource."
              }
            ]
          },
          "docs": "Retrieve a mobile phone number with messaging settings"
        }
      ]
    }
  ],
  "bundled": true
}