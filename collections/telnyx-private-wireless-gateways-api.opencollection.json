{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telnyx Access Tokens Private Wireless Gateways API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Private Wireless Gateways",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all Private Wireless Gateways",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/private_wireless_gateways",
            "params": [
              {
                "name": "page[number]",
                "value": "",
                "type": "query",
                "description": "The page number to load."
              },
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "The size of the page."
              },
              {
                "name": "filter[name]",
                "value": "my private gateway",
                "type": "query",
                "description": "The name of the Private Wireless Gateway."
              },
              {
                "name": "filter[ip_range]",
                "value": "192.168.0.0/24",
                "type": "query",
                "description": "The IP address range of the Private Wireless Gateway."
              },
              {
                "name": "filter[region_code]",
                "value": "dc2",
                "type": "query",
                "description": "The name of the region where the Private Wireless Gateway is deployed."
              },
              {
                "name": "filter[created_at]",
                "value": "2018-02-02T22:25:27.521Z",
                "type": "query",
                "description": "Private Wireless Gateway resource creation date."
              },
              {
                "name": "filter[updated_at]",
                "value": "2018-02-02T22:25:27.521Z",
                "type": "query",
                "description": "When the Private Wireless Gateway was last updated."
              }
            ]
          },
          "docs": "Get all Private Wireless Gateways belonging to the user."
        },
        {
          "info": {
            "name": "Create a Private Wireless Gateway",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.telnyx.com/v2/private_wireless_gateways",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Asynchronously create a Private Wireless Gateway for SIM cards for a previously created network. This operation may take several minutes so you can check the Private Wireless Gateway status at the section Get a Private Wireless Gateway."
        },
        {
          "info": {
            "name": "Get a Private Wireless Gateway",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/private_wireless_gateways/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Identifies the private wireless gateway."
              }
            ]
          },
          "docs": "Retrieve information about a Private Wireless Gateway."
        },
        {
          "info": {
            "name": "Delete a Private Wireless Gateway",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.telnyx.com/v2/private_wireless_gateways/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Identifies the private wireless gateway."
              }
            ]
          },
          "docs": "Deletes the Private Wireless Gateway."
        }
      ]
    }
  ],
  "bundled": true
}