          "name": "Get monthly charges breakdown",
          "request": {
            "name": "Get monthly charges breakdown",
            "description": {
              "content": "Retrieve a detailed breakdown of monthly charges for phone numbers in a specified date range. The date range cannot exceed 31 days.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "charges_breakdown"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<date>",
                  "description": "(Required) Start date for the charges breakdown in ISO date format (YYYY-MM-DD)"
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<date>",
                  "description": "End date for the charges breakdown in ISO date format (YYYY-MM-DD). If not provided, defaults to start_date + 1 month. The date is exclusive, data for the end_date itself is not included in the report. The interval between start_date and end_date cannot exceed 31 days."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Response format"
                }
              ],
              "variable": []
            },
            "header": [
