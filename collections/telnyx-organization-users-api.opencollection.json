{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telnyx Access Tokens Organization Users API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Organization Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List organization users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/organizations/users",
            "params": [
              {
                "name": "page[number]",
                "value": "",
                "type": "query",
                "description": "The page number to load"
              },
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "The size of the page"
              },
              {
                "name": "filter[user_status]",
                "value": "",
                "type": "query",
                "description": "Filter by user status"
              },
              {
                "name": "filter[email]",
                "value": "",
                "type": "query",
                "description": "Filter by email address (partial match)"
              },
              {
                "name": "include_groups",
                "value": "",
                "type": "query",
                "description": "When set to true, includes the groups array for each user in the response. The groups array contains objects with id and name for each group the user belongs to."
              }
            ]
          },
          "docs": "Returns a list of the users in your organization."
        },
        {
          "info": {
            "name": "Get organization users groups report",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/organizations/users/users_groups_report",
            "headers": [
              {
                "name": "Accept",
                "value": ""
              }
            ]
          },
          "docs": "Returns a report of all users in your organization with their group memberships. This endpoint returns all users without pagination and always includes group information. The report can be retrieved in JSON or CSV format by sending specific content-type headers."
        },
        {
          "info": {
            "name": "Get organization user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/organizations/users/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Organization User ID"
              },
              {
                "name": "include_groups",
                "value": "",
                "type": "query",
                "description": "When set to true, includes the groups array for each user in the response. The groups array contains objects with id and name for each group the user belongs to."
              }
            ]
          },
          "docs": "Returns a user in your organization."
        },
        {
          "info": {
            "name": "Delete organization user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.telnyx.com/v2/organizations/users/:id/actions/remove",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Organization User ID"
              }
            ]
          },
          "docs": "Deletes a user in your organization."
        }
      ]
    }
  ],
  "bundled": true
}