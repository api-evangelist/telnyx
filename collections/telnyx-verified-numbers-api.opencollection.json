{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telnyx Access Tokens Verified Numbers API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Verified Numbers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all Verified Numbers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/verified_numbers",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Consolidated page parameter (deepObject style). Use page[size] and page[number] in the query string. Originally: page[size], page[number]"
              }
            ]
          },
          "docs": "Gets a paginated list of Verified Numbers."
        },
        {
          "info": {
            "name": "Request phone number verification",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.telnyx.com/v2/verified_numbers",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Initiates phone number verification procedure. Supports DTMF extension dialing for voice calls to numbers behind IVR systems."
        },
        {
          "info": {
            "name": "Retrieve a verified number",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telnyx.com/v2/verified_numbers/:phone_number",
            "params": [
              {
                "name": "phone_number",
                "value": "",
                "type": "path",
                "description": "The phone number being requested."
              }
            ]
          },
          "docs": "Retrieve a verified number"
        },
        {
          "info": {
            "name": "Delete a verified number",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.telnyx.com/v2/verified_numbers/:phone_number",
            "params": [
              {
                "name": "phone_number",
                "value": "",
                "type": "path",
                "description": "The phone number being deleted."
              }
            ]
          },
          "docs": "Delete a verified number"
        },
        {
          "info": {
            "name": "Submit verification code",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.telnyx.com/v2/verified_numbers/:phone_number/actions/verify",
            "params": [
              {
                "name": "phone_number",
                "value": "",
                "type": "path",
                "description": "The phone number being verified."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submit verification code"
        }
      ]
    }
  ],
  "bundled": true
}