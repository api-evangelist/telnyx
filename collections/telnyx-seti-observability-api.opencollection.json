            "params": [
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Consolidated filter parameter (deepObject style). Originally: filter[product]"
              }
            ]
          },
          "docs": "Returns the results of the various black box tests"
        }
      ]
    }
  ],
  "bundled": true
}